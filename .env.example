# AFRA environment configuration
# Copy to .env and fill in real values. Never commit .env to version control.

# PostgreSQL connection string.
# Local development uses SQLite by default: file:./dev.db
# For production, switch schema provider to "postgresql" and set:
# DATABASE_URL="postgresql://user:password@host:5432/afra"

DATABASE_URL="file:./dev.db"

# Secret used to sign session tokens (openssl rand -base64 32)
AUTH_SECRET=""

# --- Optional: Google OAuth -------------------------------------------------
# When set, Google sign-in is enabled on /sign-in automatically.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Optional: object storage ----------------------------------------------
# Default storage is the local filesystem adapter (writes to .data/uploads).
# To use an S3-compatible object store instead, fill these in and implement
# the S3StorageAdapter in src/lib/storage (see README > Storage).
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=

# --- Optional: AI provider --------------------------------------------------
# Default is the built-in local generator (no network, deterministic).
# Set AI_PROVIDER=openai with a key to use an OpenAI-compatible API instead.
AI_PROVIDER=
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# --- Optional: payments -----------------------------------------------------
# Billing is not enabled in this milestone. Reserved for a future provider.
PAYMENT_PROVIDER=
PAYMENT_SECRET=
